  "files": [
    "app/assets/javascripts/**/*.js",
    "app/assets/stylesheets/**/*.css"
  ],
  "keywords": [
    "rails",
    "hotwire",
    "turbo",
    "stimulus",
    "datatable",
    "table",
    "pagination"
  ],
  "author": "Jakub Cieślar <jakub@infovation.pl>",
  "homepage": "https://infotable.infovation.eu/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcieslar/infotable.git"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@hotwired/turbo-rails": "^8.0.0",
    "sortablejs": "^1.15.0"
  }
}
