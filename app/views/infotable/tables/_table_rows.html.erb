<% records.each do |record| %>
  <%
    row_link_enabled = table_class.row_link_enabled?
    row_url = row_link_enabled ? table_class.row_link_url(record) : nil
    row_size = table_class.row_size_value
    cell_padding = case row_size
      when :slim then "px-2 py-1"
      when :mid then "px-4 py-2.5"
      else "px-6 py-4" # default
    end
    text_size = case row_size
      when :slim then "text-xs"
      when :mid then "text-sm"
      else "text-sm" # default
    end
  %>
  <%
    clickable = table_class.row_clickable?
    row_dom_id = dom_id(record) if record.respond_to?(:to_key) && record.to_key.present?
    row_data = table_class.row_data_for(record).transform_keys { |key| key.to_s.dasherize }
    row_data["row-link"] = row_url if row_url
    row_data["action"] = "click->infotable--table#handleRowClick" if clickable
  %>
  <tr <%= tag.attributes(id: row_dom_id, data: row_data) %>
      class="infotable-row group relative border-t border-gray-100 dark:border-gray-800 first:border-t-0 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors duration-150 <%= 'cursor-pointer' if clickable %> <%= table_class.row_classes_for(record) %>">
    <% if table_class.checkbox_enabled? %>
      <td class="<%= cell_padding %> w-10">
        <input type="checkbox"
               value="<%= table_class.checkbox_value(record) %>"
               aria-label="<%= t('infotable.batch.select_row') %>"
               data-infotable--table-target="rowCheckbox"
               data-action="change->infotable--table#toggleRow"
               class="h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-500">
      </td>
    <% end %>
    <% table_class.columns.each do |column| %>
      <td data-column-name="<%= column[:name] %>"
          data-default-visible="<%= column[:visible] %>"
          style="<%= infotable_cell_width_style(column, ellipsis: true) %>"
          class="<%= cell_padding %> whitespace-nowrap <%= text_size %> text-gray-700 dark:text-gray-300">
        <%= format_cell_value(record, column, table_class) %>
      </td>
    <% end %>
  </tr>
<% end %>
