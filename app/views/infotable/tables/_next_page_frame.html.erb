<%# Next page frame for infinite scroll - lazy loads when visible %>
<%# Frame src points to turbo_stream URL - Turbo handles it automatically %>
<% if @pagy.next %>
  <%= turbo_frame_tag(
    "#{params[:table_name]}_pagination",
    loading: :lazy,
    src: infotable_table_data_path(
      table_url_params(page: @pagy.next, format: :turbo_stream)
    )
  ) do %>
    <%# Loading placeholder - modern spinner design %>
    <div class="flex items-center justify-center py-12 border-t border-gray-100 dark:border-gray-800 bg-gradient-to-b from-white/[0.98] to-gray-50/[0.98] backdrop-blur-sm">
      <div class="text-center space-y-3">
        <div class="mx-auto animate-spin">
          <div class="relative">
            <svg class="h-10 w-10 text-indigo-500 dark:text-indigo-400 drop-shadow-[0_4px_12px_rgba(99,102,241,0.2)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-4 w-4 bg-indigo-500 rounded-full animate-pulse"></div>
            </div>
          </div>
        </div>
        <p class="text-sm font-medium text-gray-600 dark:text-gray-400 tracking-wide animate-pulse"><%= t('infotable.table.loading.more_items') %></p>
      </div>
    </div>
  <% end %>
<% else %>
  <%= render partial: "infotable/tables/end_indicator" %>
<% end %>
