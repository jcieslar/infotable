<%# Date filter - from/to range with date pickers %>
<div class="grid grid-cols-2 gap-2">
  <%# From date %>
  <div class="relative">
    <input type="date"
           name="filters[<%= column[:name] %>][from]"
           id="<%= infotable_filter_id(table_name, column, 'from') %>"
           placeholder="<%= t('infotable.filters.from') %>"
           class="block w-full rounded-lg border-0 bg-white pr-8 pl-3 py-2 text-base sm:text-sm text-neutral-900 placeholder:text-neutral-500 shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-600 focus:ring-offset-0 transition-all [box-shadow:inset_0_0_0_1px_rgb(212_212_212)] focus:[box-shadow:inset_0_0_0_2px_rgb(82_82_82)] disabled:cursor-not-allowed disabled:bg-neutral-100">
    <button type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
            data-action="click->infotable--drawer#clearSingleFilter"
            data-filter-name="<%= column[:name] %>"
            data-filter-type="date"
            title="<%= t('infotable.filters.clear_filter') %>">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <%# To date %>
  <div class="relative">
    <input type="date"
           name="filters[<%= column[:name] %>][to]"
           id="<%= infotable_filter_id(table_name, column, 'to') %>"
           placeholder="<%= t('infotable.filters.to') %>"
           class="block w-full rounded-lg border-0 bg-white pr-3 pl-3 py-2 text-base sm:text-sm text-neutral-900 placeholder:text-neutral-500 shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-600 focus:ring-offset-0 transition-all [box-shadow:inset_0_0_0_1px_rgb(212_212_212)] focus:[box-shadow:inset_0_0_0_2px_rgb(82_82_82)] disabled:cursor-not-allowed disabled:bg-neutral-100">
  </div>
</div>
