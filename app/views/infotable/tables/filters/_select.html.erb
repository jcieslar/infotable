<%# Select filter - dropdown with options (single or multi-select) %>
<%
  # Options: array or Proc (optionally cached and always capped, see Infotable::TablesHelper#infotable_filter_options)
  options, total_options = infotable_filter_options(local_assigns[:table_class], column)

  # Check if multi-select is enabled
  is_multi = column[:filter_multi_select] || false
%>

<% if is_multi %>
  <%# Multi-select %>
  <div class="relative">
    <select name="filters[<%= column[:name] %>][]"
            id="<%= infotable_filter_id(table_name, column, 'value') %>"
            multiple
            size="6"
            class="block w-full appearance-none rounded-lg border-0 bg-white pl-3 py-2 pr-8 text-base sm:text-sm text-neutral-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-600 focus:ring-offset-0 transition-all [box-shadow:inset_0_0_0_1px_rgb(212_212_212)] focus:[box-shadow:inset_0_0_0_2px_rgb(82_82_82)] cursor-pointer disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:opacity-75"
            style="min-height: 120px;">
      <% options.each do |option| %>
        <% if option.is_a?(Array) %>
          <option value="<%= option[1] %>"><%= option[0] %></option>
        <% else %>
          <option value="<%= option %>"><%= option %></option>
        <% end %>
      <% end %>
    </select>
    <button type="button"
            class="absolute right-2 top-2 text-gray-400 hover:text-gray-600 transition-colors"
            data-action="click->infotable--drawer#clearSingleFilter"
            data-filter-name="<%= column[:name] %>"
            data-filter-type="select"
            title="<%= t('infotable.filters.clear_filter') %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <p class="mt-1.5 text-xs text-neutral-500"><%= t('infotable.filters.multi_select_hint') %></p>
<% else %>
  <%# Single select %>
  <div class="relative">
    <select name="filters[<%= column[:name] %>][value]"
            id="<%= infotable_filter_id(table_name, column, 'value') %>"
            class="block w-full appearance-none rounded-lg border-0 bg-white pr-10 pl-3 py-2 text-base sm:text-sm text-neutral-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-600 focus:ring-offset-0 transition-all [box-shadow:inset_0_0_0_1px_rgb(212_212_212)] focus:[box-shadow:inset_0_0_0_2px_rgb(82_82_82)] cursor-pointer disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:opacity-75 bg-[url('data:image/svg+xml,%3csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20fill=%27none%27%20viewBox=%270%200%2020%2020%27%3e%3cpath%20stroke=%27%23737373%27%20stroke-linecap=%27round%27%20stroke-linejoin=%27round%27%20stroke-width=%271.5%27%20d=%27M6%208l4%204%204-4%27/%3e%3c/svg%3e')] bg-[right_0.75rem_center] bg-no-repeat bg-[length:1.25em_1.25em]">
      <option value=""><%= t('infotable.filters.all') %></option>
      <% options.each do |option| %>
        <% if option.is_a?(Array) %>
          <option value="<%= option[1] %>"><%= option[0] %></option>
        <% else %>
          <option value="<%= option %>"><%= option %></option>
        <% end %>
      <% end %>
    </select>
    <button type="button"
            class="absolute right-8 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
            data-action="click->infotable--drawer#clearSingleFilter"
            data-filter-name="<%= column[:name] %>"
            data-filter-type="select"
            title="<%= t('infotable.filters.clear_filter') %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
<% end %>
<% if total_options > options.size %>
  <p class="mt-1.5 text-xs text-amber-600" data-filter-options-truncated><%= t('infotable.filters.options_truncated', shown: options.size, total: total_options) %></p>
<% end %>
