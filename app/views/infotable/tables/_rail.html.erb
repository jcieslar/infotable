<%# Vertical rail with the table controls (`toolbar :rail`) %>
<% button = "relative flex items-center justify-center w-10 h-10 rounded-lg text-gray-500 dark:text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-950 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors" %>
<% icon = "w-5 h-5" %>
<% filter_count = initial_state[:filters].respond_to?(:keys) ? initial_state[:filters].keys.size : 0 %>
<aside data-infotable--drawer-target="rail" class="relative z-40 flex flex-col items-center shrink-0 w-14 py-3 gap-1 transition-all duration-300 ease-in-out border-l border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900" aria-label="<%= t('infotable.drawer.label') %>">
  <% if table_class.filterable_columns.any? && table_class.filters_button_visible? %>
    <button type="button"
            data-action="click->infotable--drawer#toggleFilters"
            title="<%= t('infotable.table.buttons.filters') %>"
            aria-label="<%= t('infotable.table.buttons.filters') %>"
            class="<%= button %>">
      <svg class="<%= icon %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
      </svg>
      <span data-infotable--table-target="filterCount"
            class="<%= 'hidden ' if filter_count.zero? %>absolute -top-1 -right-1 min-w-5 h-5 px-1 flex items-center justify-center text-xs font-medium text-white bg-indigo-600 rounded-full"><%= filter_count %></span>
    </button>
  <% end %>

  <button type="button"
          data-action="click->infotable--drawer#toggleColumns"
          title="<%= t('infotable.table.buttons.columns') %>"
          aria-label="<%= t('infotable.table.buttons.columns') %>"
          class="<%= button %>">
    <svg class="<%= icon %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  </button>

  <div class="mt-auto flex flex-col items-center gap-1 pt-3 w-10 border-t border-gray-100 dark:border-gray-800">
    <a href="<%= export_url %>"
       data-action="click->infotable--table#exportCsv"
       data-infotable--table-target="exportButton"
       data-exporting-text="<%= t('infotable.table.buttons.exporting') %>"
       data-turbo="false"
       download
       title="<%= t('infotable.table.buttons.export_csv') %>"
       class="<%= button %>">
      <svg class="<%= icon %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      <span class="sr-only" data-infotable--table-target="exportButtonText"><%= t('infotable.table.buttons.export_csv') %></span>
    </a>

    <button type="button"
            data-action="click->infotable--table#refresh"
            title="<%= t('infotable.table.buttons.refresh') %>"
            aria-label="<%= t('infotable.table.buttons.refresh') %>"
            class="<%= button %>">
      <svg class="<%= icon %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
    </button>
  </div>
</aside>
