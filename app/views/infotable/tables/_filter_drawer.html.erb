<%# Filter Drawer - Right side sliding panel %>
<% autofilter = if config&.autofilter.nil?
      Infotable.configuration.autofilter
    else
      config.autofilter
    end %>
<div class="flex flex-col h-full">
  <%# Drawer Content - Scrollable %>
  <div class="flex-1 overflow-y-auto px-4 py-4 bg-gray-50 dark:bg-gray-950">
    <form id="filter-form-<%= table_name %>"
          action="<%= infotable_table_data_path(table_name: table_name) %>"
          method="get"
          data-table-frame="<%= table_name %>_content"
          data-action="submit->infotable--drawer#submitFilters"
          data-autofilter="<%= autofilter.to_s %>"
          class="space-y-4">

      <%# Preserve sort and per_page params %>
      <% if params[:sort].is_a?(String) && params[:sort].present? %>
        <input type="hidden" name="sort" value="<%= params[:sort] %>">
      <% end %>
      <% if params[:sort_column].present? %>
        <input type="hidden" name="sort_column" value="<%= params[:sort_column] %>">
        <input type="hidden" name="sort_direction" value="<%= params[:sort_direction] %>">
      <% end %>
      <% if params[:per_page].present? %>
        <input type="hidden" name="per_page" value="<%= params[:per_page] %>">
      <% end %>

      <%# Render filter for each filterable column %>
      <% table_class.filterable_columns.each do |column| %>
        <div class="group p-4 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all duration-150">
          <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">
            <%= column[:label] %>
          </label>

          <%= render "infotable/tables/filters/#{filter_type_for_column(column)}",
                     column: column,
                     table_name: table_name,
                     table_class: table_class %>
        </div>
      <% end %>

    </form>
  </div>

  <%# Drawer Footer with actions %>
  <div class="px-4 py-3 border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900">
    <div class="flex gap-2">
      <button type="button"
              data-action="click->infotable--drawer#clearFilters"
              data-table-name="<%= table_name %>"
              class="<%= autofilter ? 'w-full' : 'flex-1' %> px-4 py-2 border border-gray-200 dark:border-gray-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-indigo-500 transition-all">
        <%= t('infotable.filters.actions.clear_all') %>
      </button>
      <% unless autofilter %>
        <button type="submit"
                form="filter-form-<%= table_name %>"
                class="flex-1 px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-indigo-500 transition-all">
          <%= t('infotable.filters.actions.apply_filters') %>
        </button>
      <% end %>
    </div>
  </div>
</div>
