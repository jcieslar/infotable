<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
  <div class="container mx-auto px-4">
    <%# Page header %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-12 h-12 bg-green-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Comments Management</h1>
          <p class="text-gray-600 mt-1">
            Relational data with multiple joins, text columns & dynamic formatting
          </p>
          <div class="mt-2 flex gap-4">
            <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Authors", authors_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Posts", posts_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Comments", comments_path, class: "text-green-600 hover:text-green-800 font-semibold" %>
          </div>
        </div>
      </div>
    </div>

    <%# InfoTable %>
    <%= infotable :comments_table %>

    <%# Footer info %>
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-500">
        Built with
        <span class="font-semibold text-indigo-600">InfoTable</span>
        • Powered by Rails 8, Hotwire & Tailwind CSS
      </p>
    </div>
  </div>
</div>
