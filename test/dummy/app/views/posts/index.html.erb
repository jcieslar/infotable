<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
  <div class="container mx-auto px-4">
    <%# Page header %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Blog Posts</h1>
          <p class="text-gray-600 mt-1">
            Advanced features: Infinite scroll, badges, custom formatters & relational data
          </p>
          <div class="mt-2 flex gap-4">
            <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Authors", authors_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Posts", posts_path, class: "text-blue-600 hover:text-blue-800 font-semibold" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Comments", comments_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
          </div>
        </div>
      </div>
    </div>

    <%# InfoTable %>
    <%= infotable :posts_table %>

    <%# Footer info %>
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-500">
        Built with
        <span class="font-semibold text-indigo-600">InfoTable</span>
        • Powered by Rails 8, Hotwire & Tailwind CSS
      </p>
    </div>
  </div>
</div>
