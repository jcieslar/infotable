<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
  <div class="container mx-auto px-4">
    <%# Page header %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Users Management</h1>
          <p class="text-gray-600 mt-1">
            InfoTable Demo - Modern datatable for Rails 8+ with Hotwire
          </p>
          <div class="mt-2 flex gap-4">
            <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Users Only", users_path, class: "text-indigo-600 hover:text-indigo-800 font-semibold" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Products Only", products_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
          </div>
        </div>
      </div>
    </div>

    <%# InfoTable %>
    <%= infotable :users_table %>

    <%# Footer info %>
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-500">
        Built with
        <span class="font-semibold text-indigo-600">InfoTable</span>
        • Powered by Rails 8, Hotwire & Tailwind CSS
      </p>
    </div>
  </div>
</div>
