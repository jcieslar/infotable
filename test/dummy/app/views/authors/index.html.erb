<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
  <div class="container mx-auto px-4">
    <%# Page header %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-12 h-12 bg-purple-600 rounded-xl flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Authors Directory</h1>
          <p class="text-gray-600 mt-1">
            Showcase of custom column widths and boolean formatters
          </p>
          <div class="mt-2 flex gap-4">
            <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Authors", authors_path, class: "text-purple-600 hover:text-purple-800 font-semibold" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Posts", posts_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Comments", comments_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
          </div>
        </div>
      </div>
    </div>

    <%# InfoTable %>
    <%= infotable :authors_table %>

    <%# Footer info %>
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-500">
        Built with
        <span class="font-semibold text-indigo-600">InfoTable</span>
        • Powered by Rails 8, Hotwire & Tailwind CSS
      </p>
    </div>
  </div>
</div>
