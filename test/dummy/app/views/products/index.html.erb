<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Products</h1>
    <p class="mt-2 text-gray-600">Browse through our extensive product catalog with 100k+ items</p>
    <div class="mt-4 flex gap-4">
      <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
      <span class="text-gray-300">|</span>
      <%= link_to "Users Only", users_path, class: "text-gray-600 hover:text-indigo-600 font-medium" %>
      <span class="text-gray-300">|</span>
      <%= link_to "Products Only", products_path, class: "text-indigo-600 hover:text-indigo-800 font-semibold" %>
    </div>
  </div>

  <%= render "infotable/tables/table", table_name: "products_table", table_class: ProductsTable %>
</div>
