<%# Navigation shared by every demo page; the current page is highlighted %>
<%
  links = [
    [ "Dashboard", root_path, "indigo" ],
    [ "Users", users_path, "indigo" ],
    [ "Products", products_path, "indigo" ],
    [ "Authors", authors_path, "purple" ],
    [ "Posts", posts_path, "blue" ],
    [ "Comments", comments_path, "green" ]
  ]
  # Full class names, so Tailwind finds them
  active = { "indigo" => "text-indigo-600 hover:text-indigo-800", "purple" => "text-purple-600 hover:text-purple-800",
             "blue" => "text-blue-600 hover:text-blue-800", "green" => "text-green-600 hover:text-green-800" }
  idle = { "indigo" => "hover:text-indigo-600", "purple" => "hover:text-purple-600",
           "blue" => "hover:text-blue-600", "green" => "hover:text-green-600" }
%>
<nav class="mt-3 flex gap-4 items-center flex-wrap" aria-label="Examples">
  <% links.each_with_index do |(label, path, color), i| %>
    <% current = current_page?(path) %>
    <% if i.positive? %><span class="text-gray-300" aria-hidden="true">|</span><% end %>
    <%= link_to label, path,
                class: (current ? "#{active[color]} font-semibold" : "text-gray-600 #{idle[color]} font-medium"),
                aria: { current: (current ? "page" : nil) } %>
  <% end %>
</nav>
